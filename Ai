// 제공해주신 Groq API 키
const GROQ_API_KEY = "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";
const GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions";

/**
 * 미디어 제목을 분석하여 AI가 구체적인 해시태그를 생성하는 함수
 * @param {string} title - 사용자가 입력한 미디어 제목
 * @returns {Promise<string>} - AI가 추천하는 해시태그 문자열 (예: "#일상 #브이로그 #풍경")
 */
async function generateHashtags(title) {
  try {
    const response = await fetch(GROQ_API_URL, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${GROQ_API_KEY}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: "llama-3.3-70b-versatile",
        messages: [
          {
            role: "system",
            content: `당신은 미디어(사진/영상) 분석 및 해시태그 생성 전문가입니다. 
            사용자가 입력한 미디어의 제목이나 내용을 분석해 카테고리를 분류하고, 가장 구체적이고 잘 어울리는 해시태그 3~5개를 추천하세요. 
            [조건]
            1. 반드시 '#태그1 #태그2' 형식으로 띄어쓰기로 구분하여 출력할 것.
            2. 다른 부연 설명이나 인사는 일절 하지 말 것.`
          },
          {
            role: "user",
            content: `다음 미디어의 제목/내용을 분석해서 해시태그를 달아줘: "${title}"`
          }
        ],
        temperature: 0.7,
        max_tokens: 150
      })
    });

    if (!response.ok) {
      throw new Error(`AI API 통신 오류 발생: ${response.status}`);
    }

    const data = await response.json();
    if (data.choices && data.choices.length > 0) {
      return data.choices[0].message.content.trim();
    }
    return "";
  } catch (error) {
    console.error("Groq API 통신 실패 (해시태그 생성 불가):", error);
    return "";
  }
}
